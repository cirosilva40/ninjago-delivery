{
  "name": "Recompensa",
  "type": "object",
  "properties": {
    "pizzaria_id": {
      "type": "string",
      "description": "ID da pizzaria"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da recompensa"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "pontos_necessarios": {
      "type": "number",
      "description": "Quantidade de pontos necess\u00e1rios para resgatar"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "desconto_percentual",
        "desconto_valor",
        "produto_gratis",
        "entrega_gratis",
        "upgrade"
      ],
      "default": "desconto_valor",
      "description": "Tipo de recompensa"
    },
    "valor_desconto": {
      "type": "number",
      "description": "Valor do desconto (em % ou R$)"
    },
    "produto_id": {
      "type": "string",
      "description": "ID do produto gr\u00e1tis (se aplic\u00e1vel)"
    },
    "imagem_url": {
      "type": "string",
      "description": "Imagem da recompensa"
    },
    "ativa": {
      "type": "boolean",
      "default": true,
      "description": "Se a recompensa est\u00e1 dispon\u00edvel"
    },
    "quantidade_disponivel": {
      "type": "number",
      "description": "Quantidade limitada dispon\u00edvel (opcional)"
    },
    "validade_dias": {
      "type": "number",
      "description": "Validade do cupom ap\u00f3s resgate (em dias)"
    }
  },
  "required": [
    "titulo",
    "pontos_necessarios",
    "tipo"
  ]
}