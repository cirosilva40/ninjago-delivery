{
  "name": "MovimentacaoEstoque",
  "type": "object",
  "properties": {
    "pizzaria_id": {
      "type": "string"
    },
    "estoque_item_id": {
      "type": "string",
      "description": "ID do item de estoque"
    },
    "estoque_item_nome": {
      "type": "string",
      "description": "Nome do item (snapshot para hist\u00f3rico)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "entrada",
        "saida",
        "ajuste"
      ],
      "default": "entrada"
    },
    "motivo": {
      "type": "string",
      "enum": [
        "compra",
        "venda",
        "perda",
        "vencimento",
        "ajuste_manual",
        "devolucao"
      ],
      "default": "compra"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade movimentada (sempre positivo)"
    },
    "custo_unitario": {
      "type": "number",
      "default": 0,
      "description": "Custo unit\u00e1rio desta movimenta\u00e7\u00e3o"
    },
    "custo_total": {
      "type": "number",
      "default": 0,
      "description": "Custo total = quantidade * custo_unitario"
    },
    "quantidade_anterior": {
      "type": "number",
      "description": "Saldo antes da movimenta\u00e7\u00e3o"
    },
    "quantidade_posterior": {
      "type": "number",
      "description": "Saldo ap\u00f3s a movimenta\u00e7\u00e3o"
    },
    "pedido_id": {
      "type": "string",
      "description": "ID do pedido (quando sa\u00edda por venda)"
    },
    "nota_compra": {
      "type": "string",
      "description": "N\u00famero da nota fiscal ou refer\u00eancia da compra"
    },
    "observacoes": {
      "type": "string"
    },
    "data": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "pizzaria_id",
    "estoque_item_id",
    "tipo",
    "quantidade"
  ]
}