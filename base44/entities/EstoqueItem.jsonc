{
  "name": "EstoqueItem",
  "type": "object",
  "properties": {
    "pizzaria_id": {
      "type": "string",
      "description": "ID do estabelecimento"
    },
    "nome": {
      "type": "string",
      "description": "Nome do item"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "insumos",
        "descartaveis",
        "limpeza",
        "embalagens",
        "bebidas",
        "outros"
      ],
      "default": "insumos"
    },
    "unidade_medida": {
      "type": "string",
      "enum": [
        "unidade",
        "kg",
        "g",
        "litro",
        "ml",
        "cx",
        "pacote",
        "saco",
        "fardo"
      ],
      "default": "unidade"
    },
    "quantidade_atual": {
      "type": "number",
      "default": 0,
      "description": "Quantidade em estoque"
    },
    "custo_unitario_medio": {
      "type": "number",
      "default": 0,
      "description": "Custo m\u00e9dio ponderado por unidade"
    },
    "alerta_minimo": {
      "type": "number",
      "default": 0,
      "description": "Quantidade m\u00ednima para alerta de estoque baixo"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "pizzaria_id",
    "nome",
    "unidade_medida"
  ]
}